    type: Curve
    min: 0
    max: 100
    default_value: 0
    is_flag: false
    flag: ""
    skip_output_if_default: false
  velc:
    name: velocity (curve)
    abbr: velc
    type: Curve
    min: 0
    max: 200
    default_value: 100
    is_flag: false
    flag: ""
    skip_output_if_default: false
  ene:
    name: energy (curve)
