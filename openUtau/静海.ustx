    type: Curve
    min: 0
    max: 100
    default_value: 100
    is_flag: false
    flag: ""
    skip_output_if_default: false
  clry:
    name: voice color y
    abbr: clry
    type: Options
    min: 0
    max: 0
    default_value: 0
    is_flag: false
    options:
    - ""
    skip_output_if_default: false
  xsy:
    name: cross synthesis (curve)
